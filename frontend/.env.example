NEXT_PUBLIC_API_URL="http://localhost:4001"

# IP de este equipo en la WiFi, para abrir el sitio desde un celular en modo
# desarrollo (separadas por coma si son varias).
# NEXT_DEV_ALLOWED_ORIGINS=192.168.x.y

# Dirección pública del sitio (la que abren los clientes al escanear el QR),
# p. ej. "https://pedidos.mirestaurante.com". Si se deja vacía, los QR usan
# la dirección desde donde se abra el panel de admin, que en local es
# localhost o la IP del wifi y NO sirve para imprimir los QR definitivos.
# NEXT_PUBLIC_URL_PUBLICA=""
