DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4001
# Orígenes del frontend separados por coma; agrega la IP del equipo para
# probar desde un celular en la misma WiFi (http://192.168.x.y:3010).
FRONTEND_URL="http://localhost:3010"

# Contraseña del administrador que crea el seed (solo al crearlo).
SEED_ADMIN_PASSWORD=""

# Solo en producción detrás de un proxy (Nginx, Render, Railway...): número de
# proxies delante del backend, para que los límites por dispositivo vean la IP
# real del cliente y no la del proxy. En local se deja comentado.
# TRUST_PROXY=1

# Solo necesarios si el proxy de tu red bloquea la descarga de binarios de
# Prisma (error "MediaTypeBlocked" al correr prisma generate/migrate). Apuntan
# a un query_engine.dll.node / schema-engine.exe ya descargados en disco.
# PRISMA_QUERY_ENGINE_LIBRARY=""
# PRISMA_SCHEMA_ENGINE_BINARY=""
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
