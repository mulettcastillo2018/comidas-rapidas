generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MESERO
  COCINA
  // Cuenta de pantalla/kiosco: solo lectura, muestra al público el estado de
  // los pedidos activos (p. ej. en un TV del local).
  PANTALLA
}

model User {
  id                 String        @id @default(cuid())
  nombre             String        @default("")
  apellido           String        @default("")
  email              String        @unique
  passwordHash       String
  // Clave de supervisor (solo admins): autoriza en el celular del mesero lo
  // que no debe hacer solo, como registrar que un cliente se fue sin pagar.
  pinHash            String?
  role               Role
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  mesaSesiones       MesaSesion[]
  pedidos            Pedido[]
  pedidoStatusLogs   PedidoStatusLog[]
  pedidoItemStatusLogs PedidoItemStatusLog[] @relation("CambiosDeItem")
  cancelacionesAutorizadas PedidoItemStatusLog[] @relation("CancelacionesAutorizadas")
  facturasCerradas   Factura[]         @relation("FacturasCerradas")
  perdidasAutorizadas Factura[]        @relation("PerdidasAutorizadas")
  descuentosAutorizados Factura[]      @relation("DescuentosAutorizados")
  movimientosInventario MovimientoInventario[]
  movimientosInsumo  MovimientoInsumo[]
  encuestasAtendidas Encuesta[]        @relation("EncuestasMesero")
  mesasAsignadas     Mesa[]            @relation("MesaAsignada")
  notificaciones     Notificacion[]
  solicitudesResueltas SolicitudPedido[]
  cierresCaja        CierreCaja[]
  entregasCaja       MovimientoCaja[]  @relation("EntregasMesero")
  movimientosCaja    MovimientoCaja[]  @relation("MovimientosRegistrados")
  gastosRegistrados  Gasto[]           @relation("GastosRegistrados")
  turnos             Turno[]           @relation("TurnosDelUsuario")
  turnosEditados     Turno[]           @relation("TurnosEditados")
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  slug      String     @unique
  icono     String?
  productos Producto[]
}

model Producto {
  id                     String       @id @default(cuid())
  nombre                 String
  descripcion            String
  precio                 Int
  tiempoPreparacionMinutos Int
  categoriaId            String
  categoria              Categoria    @relation(fields: [categoriaId], references: [id])
  imagenUrl              String?
  // false para lo que no se prepara (gaseosas, agua, productos empacados): el
  // mesero lo toma directo, así que nace "listo" y no ocupa la fila de cocina.
  requiereCocina         Boolean      @default(true)
  // Lo que le cuesta al negocio una unidad (insumos + empaque), para saber
  // cuánto deja cada venta. null = todavía no se ha configurado.
  costo                  Int?
  // Inventario por unidades (bebidas, empacados): cada venta descuenta y al
  // llegar a cero el producto se marca agotado solo.
  controlaStock          Boolean      @default(false)
  stock                  Int          @default(0)
  stockMinimo            Int          @default(0)
  // Se agotó por llegar a cero (no porque alguien lo marcara): al volver a
  // entrar mercancía se reactiva solo.
  agotadoPorStock        Boolean      @default(false)
  // Ya se avisó que está por debajo del mínimo (para no repetir el aviso).
  alertaStockBajo        Boolean      @default(false)
  movimientosInventario  MovimientoInventario[]
  disponible             Boolean      @default(true)
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  pedidoItems            PedidoItem[]
  solicitudItems         SolicitudPedidoItem[]
  // Adiciones que se le pueden poner (extra queso, sin cebolla...).
  adiciones              ProductoAdicion[]
  // Un combo es un producto hecho de otros productos (hamburguesa + papas +
  // gaseosa) con un precio propio. Al pedirlo se registran sus partes, para
  // que cocina, inventario y ganancia funcionen igual que con lo demás.
  esCombo                Boolean      @default(false)
  componentes            ComboComponente[] @relation("ComboPadre")
  enCombos               ComboComponente[] @relation("ComboHijo")
  // Receta (insumos por unidad vendida). Si costoDesdeReceta, el costo se
  // calcula solo con el costo de los insumos.
  receta                 RecetaItem[]
  costoDesdeReceta       Boolean      @default(false)
}

enum UnidadInsumo {
  GRAMO
  MILILITRO
  UNIDAD
}

enum TipoMovimientoInsumo {
  // Llegó mercancía.
  COMPRA
  // Lo que usó una venta, según la receta.
  CONSUMO
  // Volvió porque se canceló antes de prepararse.
  DEVOLUCION
  // Conteo físico (o conteo inicial).
  AJUSTE
}

// Ingrediente con que se prepara (carne, pan, papa, queso...). El stock y el
// costo van en la unidad base: gramos, mililitros o unidades.
model Insumo {
  id              String             @id @default(cuid())
  nombre          String             @unique
  unidad          UnidadInsumo
  stock           Float              @default(0)
  stockMinimo     Float              @default(0)
  // Pesos por unidad base (promedio ponderado de las compras).
  costoUnitario   Float              @default(0)
  alertaStockBajo Boolean            @default(false)
  activo          Boolean            @default(true)
  creadoEn        DateTime           @default(now())
  recetas         RecetaItem[]
  adiciones       AdicionInsumo[]
  movimientos     MovimientoInsumo[]
}

model RecetaItem {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  insumoId   String
  insumo     Insumo   @relation(fields: [insumoId], references: [id])
  cantidad   Float

  @@unique([productoId, insumoId])
}

// Lo que gasta una adición (extra queso = 30 g de queso).
model AdicionInsumo {
  adicionId String
  adicion   Adicion @relation(fields: [adicionId], references: [id])
  insumoId  String
  insumo    Insumo  @relation(fields: [insumoId], references: [id])
  cantidad  Float

  @@id([adicionId, insumoId])
}

model MovimientoInsumo {
  id              String               @id @default(cuid())
  insumoId        String
  insumo          Insumo               @relation(fields: [insumoId], references: [id])
  tipo            TipoMovimientoInsumo
  // Con signo: + entra, − sale.
  cantidad        Float
  stockResultante Float
  // Solo compras: lo que se pagó.
  costoTotal      Int?
  nota            String?
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  pedidoItemId    String?
  creadoEn        DateTime             @default(now())

  @@index([insumoId, creadoEn])
  @@index([pedidoItemId])
}

model ComboComponente {
  id         String   @id @default(cuid())
  comboId    String
  combo      Producto @relation("ComboPadre", fields: [comboId], references: [id])
  productoId String
  producto   Producto @relation("ComboHijo", fields: [productoId], references: [id])
  cantidad   Int

  @@unique([comboId, productoId])
}

// Adición a un producto: con precio (extra queso +$2.000) o sin él (sin
// cebolla, término medio), para que quede estructurado y no como nota suelta.
model Adicion {
  id         String            @id @default(cuid())
  nombre     String
  precio     Int               @default(0)
  costo      Int?
  activa     Boolean           @default(true)
  creadoEn   DateTime          @default(now())
  productos  ProductoAdicion[]
  insumos    AdicionInsumo[]
}

model ProductoAdicion {
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  adicionId  String
  adicion    Adicion  @relation(fields: [adicionId], references: [id])

  @@id([productoId, adicionId])
}

// Lo que se le puso a un producto vendido, con su precio de ese momento.
// El precio de la línea (PedidoItem.precioUnitario) ya lo incluye.
model PedidoItemAdicion {
  id           String     @id @default(cuid())
  pedidoItemId String
  pedidoItem   PedidoItem @relation(fields: [pedidoItemId], references: [id])
  adicionId    String?
  nombre       String
  precio       Int
  costo        Int?

  @@index([pedidoItemId])
}

// Descuento por porcentaje en productos o categorías, en ciertos días y
// horas (hora feliz, martes de perros...). Se aplica solo al pedir.
model Promocion {
  id           String    @id @default(cuid())
  nombre       String
  descuentoPct Int
  activa       Boolean   @default(true)
  // 0 = domingo … 6 = sábado; vacío = todos los días.
  diasSemana   Int[]
  // "17:00"; sin horas = todo el día.
  horaInicio   String?
  horaFin      String?
  desde        DateTime?
  hasta        DateTime?
  productoIds  String[]
  categoriaIds String[]
  creadoEn     DateTime  @default(now())
}

enum MesaEstado {
  LIBRE
  OCUPADA
}

model Mesa {
  id               String       @id @default(cuid())
  numero           String       @unique
  capacidad        Int
  estado           MesaEstado   @default(LIBRE)
  // Si se asigna, solo ese mesero (o el Admin) puede abrir esta mesa. Si queda
  // en null, la mesa está "libre" y cualquier mesero puede atenderla.
  meseroAsignadoId String?
  meseroAsignado   User?        @relation("MesaAsignada", fields: [meseroAsignadoId], references: [id])
  // Una mesa con historial no se borra (sus sesiones y facturas la
  // referencian): se desactiva y deja de aparecer para meseros y QR.
  activa           Boolean      @default(true)
  sesiones         MesaSesion[]
  solicitudes      SolicitudPedido[]
}

enum MesaSesionEstado {
  ABIERTA
  CUENTA_SOLICITADA
  CERRADA
}

model MesaSesion {
  id                String           @id @default(cuid())
  mesaId            String
  mesa              Mesa             @relation(fields: [mesaId], references: [id])
  meseroId          String
  mesero            User             @relation(fields: [meseroId], references: [id])
  nombreResponsable String
  // Sillas por encima de la capacidad de la mesa (traídas de otra mesa o de
  // bodega) — el mesero debe confirmarlo explícitamente al abrir la mesa.
  sillasAdicionales Int              @default(0)
  estado            MesaSesionEstado @default(ABIERTA)
  abiertaEn         DateTime         @default(now())
  cerradaEn         DateTime?
  comensales        Comensal[]
  pedidos           Pedido[]
  factura           Factura?
  // Código aleatorio del QR de "¿cómo te atendimos?" que va en la precuenta.
  codigoEncuesta    String?          @unique
  encuesta          Encuesta?
}

// Opinión del cliente (1 a 5 estrellas y un comentario opcional): una por
// visita a la mesa o por pedido de mostrador.
model Encuesta {
  id           String           @id @default(cuid())
  mesaSesionId String?          @unique
  mesaSesion   MesaSesion?      @relation(fields: [mesaSesionId], references: [id])
  solicitudId  String?          @unique
  solicitud    SolicitudPedido? @relation(fields: [solicitudId], references: [id])
  // Quién atendió, para ver las opiniones por mesero.
  meseroId     String?
  mesero       User?            @relation("EncuestasMesero", fields: [meseroId], references: [id])
  calificacion Int
  comentario   String?
  creadaEn     DateTime         @default(now())

  @@index([creadaEn])
}

model Comensal {
  id           String       @id @default(cuid())
  mesaSesionId String
  mesaSesion   MesaSesion   @relation(fields: [mesaSesionId], references: [id])
  nombre       String
  pedidoItems  PedidoItem[]
}

enum PedidoEstado {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

// Por dónde llegó el pedido.
enum CanalPedido {
  MESA
  // Para recoger en caja (QR general o cliente en el local).
  MOSTRADOR
  // Domicilio con mensajero propio (pedido por teléfono o WhatsApp).
  DOMICILIO
  // Rappi, DiDi Food, etc.: la app cobra al cliente y se queda una comisión.
  PLATAFORMA
}

model Pedido {
  // Un pedido normalmente pertenece a una mesa abierta (mesaSesionId), pero
  // también puede ser un pedido de mostrador sin ninguna mesa detrás (alguien
  // que no encontró puesto y decide pedir para recoger) — en ese caso
  // mesaSesionId queda null y se usan nombreCliente/telefonoCliente en su
  // lugar para identificar a quién pertenece.
  id             String            @id @default(cuid())
  canal          CanalPedido       @default(MOSTRADOR)
  mesaSesionId   String?
  mesaSesion     MesaSesion?       @relation(fields: [mesaSesionId], references: [id])
  nombreCliente    String?
  telefonoCliente  String?
  domicilio        Domicilio?
  plataformaId     String?
  plataforma       Plataforma?     @relation(fields: [plataformaId], references: [id])
  // Número de la orden en la app, para ubicarla cuando llega el repartidor.
  codigoPlataforma String?
  meseroId       String
  mesero         User              @relation(fields: [meseroId], references: [id])
  estado         PedidoEstado      @default(RECIBIDO)
  notasGenerales String?
  // true si este pedido nació de una SolicitudPedido que el cliente armó
  // desde el QR (de su mesa, o del mostrador) — el mesero/admin (meseroId)
  // solo la validó, no la armó él mismo. Se usa para mostrar esa aclaración.
  origenCliente  Boolean           @default(false)
  solicitudOrigen SolicitudPedido?
  creadoEn       DateTime          @default(now())
  iniciadoEn     DateTime?
  listoEn        DateTime?
  entregadoEn    DateTime?
  items          PedidoItem[]
  statusLogs     PedidoStatusLog[]
  factura        Factura?
}

enum EstadoDomicilio {
  // En cocina o listo, esperando que salga.
  PENDIENTE
  EN_CAMINO
  ENTREGADO
  // No se pudo entregar (dirección errada, el cliente no respondió...).
  FALLIDO
}

// Datos de entrega de un pedido a domicilio con mensajero propio.
model Domicilio {
  id            String          @id @default(cuid())
  pedidoId      String          @unique
  pedido        Pedido          @relation(fields: [pedidoId], references: [id])
  // Dirección, barrio e indicaciones se borran a los 30 días (Ley 1581), como
  // el teléfono.
  direccion     String?
  barrio        String?
  indicaciones  String?
  // Billete con el que va a pagar, para que el mensajero lleve las vueltas.
  pagaCon       Int?
  domiciliario  String?
  estado        EstadoDomicilio @default(PENDIENTE)
  salioEn       DateTime?
  entregadoEn   DateTime?
  motivoFallido String?
}

// Apps de domicilios con las que trabaja el negocio y su comisión.
model Plataforma {
  id          String   @id @default(cuid())
  nombre      String   @unique
  // Porcentaje que se queda la app de cada venta (p. ej. 23.5).
  comisionPct Float
  activa      Boolean  @default(true)
  pedidos     Pedido[]
}

// Cocina despacha producto por producto (no el pedido completo de una sola
// vez), así que el estado real vive aquí. Pedido.estado es un agregado
// derivado de estos ítems (ver services/pedidoAggregate.ts), útil para
// listar/filtrar sin tener que revisar cada ítem.
model PedidoItem {
  id                       String       @id @default(cuid())
  pedidoId                 String
  pedido                   Pedido       @relation(fields: [pedidoId], references: [id])
  comensalId               String?
  comensal                 Comensal?    @relation(fields: [comensalId], references: [id])
  // Domicilio para llevar dentro de una mesa abierta: el cliente sigue
  // comiendo en el restaurante pero pide algo aparte para alguien que no está
  // en la mesa. No va asignado a ningún comensal (comensalId queda null,
  // igual que "para compartir", pero con un significado distinto).
  paraLlevar               Boolean      @default(false)
  productoId               String
  producto                 Producto     @relation(fields: [productoId], references: [id])
  cantidad                 Int
  notas                    String?
  // Precio final por unidad: producto + adiciones − promoción (o la parte
  // del precio de un combo que le corresponde).
  precioUnitario           Int
  // Costo al momento de venderlo (como el precio): si el costo del producto
  // cambia después, la ganancia de las ventas pasadas no se altera.
  costoUnitario            Int?
  adiciones                PedidoItemAdicion[]
  // Promoción aplicada: precio sin descuento y su nombre, para mostrarlo.
  precioLista              Int?
  promocionNombre          String?
  // Partes de un mismo combo comparten comboGrupo.
  comboGrupo               String?
  comboNombre              String?
  tiempoPreparacionMinutos Int
  estado                   PedidoEstado @default(RECIBIDO)
  iniciadoEn               DateTime?
  listoEn                  DateTime?
  // Evita reenviar la alerta de retraso cada vez que el chequeo periódico
  // corre; se marca true la primera vez que se notifica el retraso.
  retrasoNotificado        Boolean      @default(false)
  statusLogs               PedidoItemStatusLog[]
}

model PedidoItemStatusLog {
  id            String        @id @default(cuid())
  pedidoItemId  String
  pedidoItem    PedidoItem    @relation(fields: [pedidoItemId], references: [id])
  deEstado      PedidoEstado?
  aEstado       PedidoEstado
  cambiadoPorId String
  cambiadoPor   User          @relation("CambiosDeItem", fields: [cambiadoPorId], references: [id])
  // Admin que autorizó con su clave (p. ej. cancelar algo que cocina ya
  // estaba preparando). null = no necesitaba autorización.
  autorizadoPorId String?
  autorizadoPor   User?       @relation("CancelacionesAutorizadas", fields: [autorizadoPorId], references: [id])
  cambiadoEn    DateTime      @default(now())
}

// Trazabilidad de cada cambio de estado de un pedido (mismo patrón que
// PqrsStatusLog/ProductDiscountLog en tienda-virtual) — permite medir después
// tiempos reales de preparación vs. estimados.
model PedidoStatusLog {
  id           String       @id @default(cuid())
  pedidoId     String
  pedido       Pedido       @relation(fields: [pedidoId], references: [id])
  deEstado     PedidoEstado?
  aEstado      PedidoEstado
  cambiadoPorId String
  cambiadoPor  User         @relation(fields: [cambiadoPorId], references: [id])
  cambiadoEn   DateTime     @default(now())
}

enum FacturaEstado {
  PENDIENTE
  PAGADA
  // El cliente se fue sin pagar (o se decidió no cobrar). Se usa para poder
  // cerrar la mesa igual y dejar registrada la pérdida, en vez de dejarla
  // atascada en PENDIENTE para siempre.
  PERDIDA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  NEQUI
  DAVIPLATA
  // Transferencia bancaria, QR bancario, Bre-B.
  TRANSFERENCIA
  OTRO
  // Lo cobró una app de domicilios, que le paga al negocio después (no entra
  // a la caja).
  PLATAFORMA
}

// Cómo se pagó una cuenta. Una cuenta puede pagarse con varios métodos (parte
// en efectivo y parte por Nequi, o cada comensal por su lado); la suma de sus
// pagos es el total de la cuenta.
model PagoFactura {
  id        String     @id @default(cuid())
  facturaId String
  factura   Factura    @relation(fields: [facturaId], references: [id])
  metodo    MetodoPago
  monto     Int
  creadoEn  DateTime   @default(now())

  @@index([facturaId])
}

enum TipoMovimientoInventario {
  // Llegó mercancía (compra).
  ENTRADA
  // Salió por una venta.
  VENTA
  // Volvió al inventario porque se canceló antes de usarse.
  DEVOLUCION
  // Corrección tras contar físicamente.
  AJUSTE
}

model MovimientoInventario {
  id              String                   @id @default(cuid())
  productoId      String
  producto        Producto                 @relation(fields: [productoId], references: [id])
  tipo            TipoMovimientoInventario
  // Con signo: + entra, − sale.
  cantidad        Int
  stockResultante Int
  nota            String?
  userId          String?
  user            User?                    @relation(fields: [userId], references: [id])
  pedidoItemId    String?
  creadoEn        DateTime                 @default(now())

  @@index([productoId, creadoEn])
}

enum TipoMovimientoCaja {
  // Plata que entra a la caja sin ser una venta (p. ej. más base).
  ENTRADA
  // Plata que sale de la caja (pago a un proveedor, retiro del dueño).
  SALIDA
  // Un mesero entrega a la caja el efectivo que cobró en las mesas. No cambia
  // lo que debe haber en caja al cierre: sirve para saber quién entregó qué.
  ENTREGA_MESERO
}

model MovimientoCaja {
  id              String             @id @default(cuid())
  tipo            TipoMovimientoCaja
  monto           Int
  concepto        String
  meseroId        String?
  mesero          User?              @relation("EntregasMesero", fields: [meseroId], references: [id])
  registradoPorId String
  registradoPor   User               @relation("MovimientosRegistrados", fields: [registradoPorId], references: [id])
  creadoEn        DateTime           @default(now())
  cierreCajaId    String?
  cierreCaja      CierreCaja?        @relation(fields: [cierreCajaId], references: [id])
  // Si es el pago de un gasto con plata de la caja.
  gasto           Gasto?

  @@index([cierreCajaId])
}

enum CategoriaGasto {
  // Carne, pan, papas, gaseosas para la venta, empaques...
  INSUMOS
  NOMINA
  ARRIENDO
  // Luz, agua, gas, internet.
  SERVICIOS
  MANTENIMIENTO
  PUBLICIDAD
  IMPUESTOS
  OTROS
}

// Lo que se paga para operar, para saber cuánto queda de verdad (estado de
// resultados) y cuánto hay que vender para no perder (punto de equilibrio).
model Gasto {
  id               String          @id @default(cuid())
  // Día al que corresponde (hora de Colombia, guardado a mediodía).
  fecha            DateTime
  categoria        CategoriaGasto
  concepto         String
  monto            Int
  // Fijo: se paga igual se venda o no (arriendo, nómina base, servicios).
  esFijo           Boolean         @default(false)
  // Pagado con efectivo de la caja: queda como salida en el turno.
  movimientoCajaId String?         @unique
  movimientoCaja   MovimientoCaja? @relation(fields: [movimientoCajaId], references: [id])
  registradoPorId  String
  registradoPor    User            @relation("GastosRegistrados", fields: [registradoPorId], references: [id])
  creadoEn         DateTime        @default(now())

  @@index([fecha])
}

// Entrada y salida de cada persona, para repartir las propinas según las
// horas trabajadas.
model Turno {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TurnosDelUsuario", fields: [userId], references: [id])
  entrada      DateTime  @default(now())
  // null = sigue trabajando.
  salida       DateTime?
  // Admin que lo corrigió (p. ej. se le olvidó marcar la salida).
  editadoPorId String?
  editadoPor   User?     @relation("TurnosEditados", fields: [editadoPorId], references: [id])

  @@index([userId, entrada])
  @@index([entrada])
}

enum ModoPropina {
  // Cada mesero se queda con las propinas de sus mesas.
  PROPIAS
  // Las propinas del salón se juntan y se reparten por horas trabajadas.
  POZO
}

// Ajustes del negocio (una sola fila, id "unica").
model Configuracion {
  id               String      @id @default("unica")
  // Parte de las propinas que va para cocina (se reparte entre la gente de
  // cocina según sus horas).
  propinaPctCocina Int         @default(0)
  propinaModo      ModoPropina @default(PROPIAS)
}

enum NotificacionTipo {
  PEDIDO_NUEVO
  ITEM_RETRASADO
  ITEM_LISTO
  SOLICITUD_PEDIDO_CLIENTE
  ITEM_CANCELADO
  // Al admin: algo que se hizo con su clave de supervisor.
  AUTORIZACION
  // Al admin: un producto con inventario se agotó o quedó bajo el mínimo.
  STOCK
  // Al mesero: el cliente tocó "Llamar al mesero" o "Pedir la cuenta" en el QR.
  LLAMADO_MESA
  // Al admin: un cliente calificó mal la atención.
  OPINION
  // Al admin: la DIAN rechazó un documento o se acaba la numeración.
  FACTURACION
}

// Notificación entregada a un usuario puntual (mesero dueño de la mesa,
// o cada usuario de COCINA activo cuando aplica) — persistida para que el
// centro de notificaciones sobreviva a un refresh, y empujada en vivo por
// Socket.IO al momento de crearse.
model Notificacion {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  tipo         NotificacionTipo
  mensaje      String
  pedidoId     String?
  pedidoItemId String?
  // Pantalla a la que lleva al hacer clic (p. ej. la mesa donde está el
  // producto listo), con lo que hay que resaltar en la URL. Se calcula al
  // crearla porque después la mesa puede haberse cerrado o cambiado.
  enlace       String?
  leida        Boolean          @default(false)
  creadaEn     DateTime         @default(now())
}

enum SolicitudPedidoEstado {
  PENDIENTE
  CONFIRMADA
  DESCARTADA
}

// El cliente arma esto desde la carta pública mientras espera — NO es un
// Pedido real todavía. Si viene del QR de una mesa (mesaId), se convierte en
// Pedido cuando el mesero, ya con la mesa abierta, la confirma. Si viene del
// QR general de mostrador (mesaId null, sin mesa detrás), la confirma
// directamente el admin en caja (ver PUT /:id/confirmar-recogida), y en ese
// caso nombreCliente y telefonoCliente son obligatorios para identificar el
// pedido sin tener mesa ni mesero dueño.
model SolicitudPedido {
  id            String                @id @default(cuid())
  mesaId        String?
  mesa          Mesa?                 @relation(fields: [mesaId], references: [id])
  nombreCliente String?
  telefonoCliente String?
  estado        SolicitudPedidoEstado @default(PENDIENTE)
  items         SolicitudPedidoItem[]
  creadaEn      DateTime              @default(now())
  resueltaEn    DateTime?
  resueltaPorId String?
  resueltaPor   User?                 @relation(fields: [resueltaPorId], references: [id])
  pedidoId      String?               @unique
  pedido        Pedido?               @relation(fields: [pedidoId], references: [id])
  // Código aleatorio de la página pública /seguimiento/<código>, donde el
  // cliente ve el estado de su pedido sin cuenta ni login. Aleatorio (no el
  // id) para que no se puedan adivinar pedidos ajenos.
  codigoSeguimiento String?           @unique
  // Cuándo autorizó el cliente usar su nombre y teléfono (Ley 1581 de 2012);
  // obligatorio en pedidos de mostrador, que son los que piden esos datos.
  datosAutorizadosEn DateTime?
  encuesta      Encuesta?
}

model SolicitudPedidoItem {
  id          String          @id @default(cuid())
  solicitudId String
  solicitud   SolicitudPedido @relation(fields: [solicitudId], references: [id])
  productoId  String
  producto    Producto        @relation(fields: [productoId], references: [id])
  cantidad    Int
  notas       String?
  paraLlevar  Boolean         @default(false)
  // Adiciones que el cliente eligió en la carta.
  adicionIds  String[]
}

model Factura {
  // Igual que Pedido: normalmente ligada a una mesa (mesaSesionId), pero una
  // cuenta de mostrador se liga directo a su Pedido (pedidoId) porque no hay
  // ninguna mesa/sesión detrás.
  id            String        @id @default(cuid())
  mesaSesionId  String?       @unique
  mesaSesion    MesaSesion?   @relation(fields: [mesaSesionId], references: [id])
  pedidoId      String?       @unique
  pedido        Pedido?       @relation(fields: [pedidoId], references: [id])
  subtotal      Int
  // Descuento a la cuenta completa o cortesía (100%), con motivo y quién lo
  // autorizó. total = subtotal − descuento + propina.
  descuentoMonto  Int         @default(0)
  descuentoMotivo String?
  descuentoAutorizadoPorId String?
  descuentoAutorizadoPor   User? @relation("DescuentosAutorizados", fields: [descuentoAutorizadoPorId], references: [id])
  propinaMonto  Int           @default(0)
  // Costo del domicilio que paga el cliente (incluido en el total).
  envioMonto    Int           @default(0)
  // Lo que se queda la app de domicilios (no se le cobra al cliente: es un
  // costo del negocio y se resta de la ganancia).
  comisionMonto Int           @default(0)
  // total = subtotal − descuento + propina + envío.
  total         Int
  estado        FacturaEstado @default(PENDIENTE)
  // El método si se pagó con uno solo; null si se dividió en varios (el
  // detalle siempre está en pagos).
  metodoPago    MetodoPago?
  pagos         PagoFactura[]
  generadaEn    DateTime      @default(now())
  pagadaEn      DateTime?
  cerradaPorId  String?
  cerradaPor    User?         @relation("FacturasCerradas", fields: [cerradaPorId], references: [id])
  // Admin que autorizó registrarla como perdida (si la registró un mesero).
  autorizadaPorId String?
  autorizadaPor   User?       @relation("PerdidasAutorizadas", fields: [autorizadaPorId], references: [id])
  // Cierre de caja en el que se contabilizó (null = todavía no se ha
  // cerrado caja desde que se cobró o se dio por perdida).
  cierreCajaId  String?
  cierreCaja    CierreCaja?   @relation(fields: [cierreCajaId], references: [id])
  // Datos del cliente que pidió la factura a su nombre (tipo y número de
  // documento, nombre, correo). null = consumidor final.
  adquiriente   Json?
  documentosFiscales DocumentoFiscal[]

  @@index([cierreCajaId])
  @@index([estado, pagadaEn])
}

enum TipoDocumentoFiscal {
  // Factura electrónica de venta.
  FACTURA
  // Documento equivalente electrónico POS (Resolución DIAN 165 de 2023).
  POS
  // Anula una factura electrónica.
  NOTA_CREDITO
  // Anula un documento POS.
  NOTA_AJUSTE
}

enum EstadoDocumentoFiscal {
  // Todavía no se pudo enviar (sin conexión, Alanube caído o sin configurar):
  // se reintenta solo.
  PENDIENTE
  // Alanube lo recibió; falta la respuesta de la DIAN.
  ENVIADO
  ACEPTADO
  // La DIAN (o Alanube) lo rechazó: hay que corregir y reenviar.
  RECHAZADO
}

enum ImpuestoVenta {
  // Impuesto nacional al consumo (restaurantes): 8%.
  INC
  IVA
  // No responsable de IVA ni de INC.
  NINGUNO
}

// Documento electrónico enviado a la DIAN por medio de Alanube, por cada
// cuenta cobrada (o nota que anula uno anterior).
model DocumentoFiscal {
  id                String                @id @default(cuid())
  facturaId         String
  factura           Factura               @relation(fields: [facturaId], references: [id])
  tipo              TipoDocumentoFiscal
  prefijo           String
  numero            Int
  estado            EstadoDocumentoFiscal @default(PENDIENTE)
  // Lo que se envía; si hay que reintentar por conexión, se reenvía igual.
  contenido         Json
  // Evita que un reintento cree el documento dos veces en la DIAN.
  claveIdempotencia String                @unique
  alanubeId         String?
  // CUFE (factura) o CUDE (POS y notas).
  codigoUnico       String?
  qr                String?
  mensaje           String?
  errores           String[]
  intentos          Int                   @default(0)
  proximoIntento    DateTime              @default(now())
  clienteNombre     String
  clienteIdentificacion String
  total             Int
  // Documento que esta nota anula.
  anulaId           String?               @unique
  anula             DocumentoFiscal?      @relation("Anulacion", fields: [anulaId], references: [id])
  anuladoPor        DocumentoFiscal?      @relation("Anulacion")
  creadoEn          DateTime              @default(now())
  actualizadoEn     DateTime              @updatedAt

  @@unique([tipo, prefijo, numero])
  @@index([estado, proximoIntento])
  @@index([facturaId])
}

// Datos para facturar electrónicamente (una sola fila, id "unica"). El token
// de Alanube puede venir de la variable ALANUBE_TOKEN o guardarse aquí.
model ConfiguracionFiscal {
  id                  String              @id @default("unica")
  activa              Boolean             @default(false)
  // Desde cuándo: las cuentas cobradas antes no se facturan.
  activadaEn          DateTime?
  alanubeUrl          String              @default("https://sandbox-api.alegra.com/e-provider/col/v1")
  alanubeToken        String?
  alanubeCompanyId    String?
  nit                 String?
  dv                  String?
  razonSocial         String?
  // Lo que se emite a un consumidor final (a quien pide factura con sus
  // datos siempre se le emite factura electrónica).
  documentoPorDefecto TipoDocumentoFiscal @default(FACTURA)
  impuesto            ImpuestoVenta       @default(INC)
  impuestoPct         Int                 @default(8)
  feResolucion        String?
  fePrefijo           String?
  feDesde             Int?
  feHasta             Int?
  feFechaInicio       String?
  feFechaFin          String?
  feClaveTecnica      String?
  feSiguiente         Int?
  posResolucion       String?
  posPrefijo          String?
  posDesde            Int?
  posHasta            Int?
  posFechaInicio      String?
  posFechaFin         String?
  posSiguiente        Int?
  notaPrefijo         String              @default("NC")
  notaSiguiente       Int                 @default(1)
  ajustePrefijo       String              @default("NA")
  ajusteSiguiente     Int                 @default(1)
  // Caja registradora (obligatorio en el documento POS).
  cajaPlaca           String?
  cajaUbicacion       String?
}

// Cierre de turno: el sistema suma lo cobrado desde el cierre anterior (por
// método de pago) y el admin registra cuánto efectivo contó físicamente en
// caja. Queda guardado y no se edita, para poder revisar descuadres después.
model CierreCaja {
  id              String    @id @default(cuid())
  desde           DateTime
  hasta           DateTime  @default(now())
  cerradoPorId    String
  cerradoPor      User      @relation(fields: [cerradoPorId], references: [id])
  cuentasPagadas  Int
  totalEfectivo   Int
  totalTarjeta    Int
  totalNequi         Int @default(0)
  totalDaviplata     Int @default(0)
  totalTransferencia Int @default(0)
  // Vendido por apps de domicilios: no entra a la caja, la app lo consigna.
  totalPlataforma    Int @default(0)
  totalOtro       Int
  // Ya incluidas en los totales de arriba; se muestran aparte para repartir.
  propinas        Int
  cuentasPerdidas Int
  totalPerdidas   Int
  // Efectivo con el que arrancó la caja (para dar vueltas).
  baseInicial     Int
  // Movimientos de efectivo que no son ventas (ver MovimientoCaja).
  totalEntradas   Int @default(0)
  totalSalidas    Int @default(0)
  efectivoContado Int
  // efectivoContado - (baseInicial + totalEfectivo + entradas - salidas):
  // negativo = falta plata.
  diferencia      Int
  notas           String?
  facturas        Factura[]
  movimientos     MovimientoCaja[]
}
